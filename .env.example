# ==============================================================================
# PlayGrid Environment Variables Guide
# ==============================================================================
# Do NOT commit this file with real secrets!
# Copy this file to backend/.env and frontend/.env respectively, 
# then fill in your private keys.
# ==============================================================================


# ==============================================================================
# BACKEND ENV VARIABLES (Place in backend/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Database (PostgreSQL via Prisma)
# ------------------------------------------------------------------------------
# The connection URL to your PostgreSQL instance. 
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/playgrid?schema=public"

# ------------------------------------------------------------------------------
# Firebase Admin SDK (Authentication)
# ------------------------------------------------------------------------------
# These are found in your Firebase Console -> Project Settings -> Service Accounts
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# WARNING: Ensure line breaks in the private key are properly formatted if passed via CI/CD.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Super-Secret-Key\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Cloudinary (Media Storage)
# ------------------------------------------------------------------------------
# Found in your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# Gemini AI (Optional - Coaching Features)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your-gemini-api-key"


# ==============================================================================
# FRONTEND ENV VARIABLES (Place in frontend/.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5001

# ------------------------------------------------------------------------------
# Firebase Client SDK
# ------------------------------------------------------------------------------
# These are found in your Firebase Console -> Project Settings -> General -> Web Apps
VITE_FIREBASE_API_KEY="your-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project-id.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"

# ------------------------------------------------------------------------------
# Mapbox (Venue Mapping)
# ------------------------------------------------------------------------------
VITE_MAPBOX_TOKEN="pk.eyJ1Ijoi..."
