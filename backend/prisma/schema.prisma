generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum Role {
  GUEST
  PLAYER
  ORGANIZER
  ADMIN
}

enum MatchStatus {
  DRAFT
  OPEN
  FULL
  ONGOING
  COMPLETED
  ARCHIVED
  CANCELLED
  EXPIRED
}

enum MatchSkillLevel {
  ALL
  BEGINNER
  INTERMEDIATE
  ADVANCED
  PRO
}

enum CommunityStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VenueStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum PostType {
  LOOKING_FOR_PLAYERS
  LOOKING_FOR_TEAM
  COMMUNITY_POST
  TOURNAMENT_ANNOUNCEMENT
  GROUND_PROMOTION
  GENERAL
  QUESTION
  EQUIPMENT
  TRAINING
}

enum ReportType {
  POST
  USER
  COMMUNITY
  VENUE
  MESSAGE
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum MatchPlayerStatus {
  PENDING
  APPROVED
  REJECTED
  ATTENDED
  WITHDRAWN
  KICKED
  WAITLISTED
}

enum TournamentParticipantStatus {
  PENDING
  APPROVED
  ELIMINATED
}

enum NotificationType {
  MATCH_REMINDER
  JOIN_REQUEST
  JOIN_APPROVED
  JOIN_REJECTED
  NEW_REPLY
  NEW_MESSAGE
  SYSTEM_ALERT
  COMMUNITY_ANNOUNCEMENT
}

enum ActivityType {
  MATCH_CREATED
  MATCH_JOINED
  MATCH_LEFT
  COMMUNITY_CREATED
  COMMUNITY_JOINED
  POST_CREATED
  COMMENT_ADDED
  VENUE_REVIEWED
  FRIEND_ADDED
  BADGE_EARNED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  BLOCKED
}

enum CommunityRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum CommunityPrivacy {
  PUBLIC
  PRIVATE
}

enum CommunityMemberStatus {
  PENDING
  APPROVED
  REJECTED
  BANNED
}

enum MatchType {
  COMPETITIVE
  CASUAL
  MEETUP
  PRACTICE
  TOURNAMENT
  TRAINING
}

// -----------------------------------------------------------------------------
// MODELS
// -----------------------------------------------------------------------------

model User {
  id          String   @id @default(uuid())
  firebaseUid String   @unique
  email       String   @unique
  name        String
  role        Role     @default(PLAYER)
  reputation  Int      @default(100)
  isBlocked   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profile Profile?
  posts   Post[]
  replies Reply[]

  // Relations
  matchesCreated      Match[]        @relation("MatchCreator")
  matchParticipations MatchPlayer[]
  matchComments       MatchComment[]

  communitiesOwned     Community[]       @relation("CommunityOwner")
  communityMemberships CommunityMember[]

  venuesOwned Venue[] @relation("VenueOwner")

  tournamentsOrganized Tournament[]            @relation("TournamentOrganizer")
  tournamentEntries    TournamentParticipant[]

  badges UserBadge[]

  messagesSent     Message[] @relation("SentMessages")
  messagesReceived Message[] @relation("ReceivedMessages")

  notifications Notification[]

  reportsSubmitted Report[] @relation("ReportSubmitter")

  activities Activity[]

  postLikes     PostLike[]
  replyLikes    ReplyLike[]
  savedPosts    SavedPost[]
  venueReviews  VenueReview[]
  reviewsWritten UserReview[] @relation("Reviewer")
  reviewsReceived UserReview[] @relation("ReviewedUser")
  matchReviews   MatchReview[]

  connectionsInitiated UserConnection[] @relation("ConnectionsInitiated")
  connectionsReceived UserConnection[] @relation("ConnectionsReceived")

  @@index([firebaseUid])
  @@index([email])
}

model Profile {
  id                 String   @id @default(uuid())
  userId             String   @unique
  bio                String?
  avatarUrl          String?
  location           String?
  sports             String[] // e.g. ["Cricket", "Football"]
  favoriteGames      String[]
  age                Int?
  homeLatitude       Float?
  homeLongitude      Float?
  preferredPlayTimes String[] // e.g. ["Weekdays", "Weekends"]
  skillLevels        Json? // e.g. { "Cricket": "PRO", "Football": "BEGINNER" }
  privacySettings    Json? // e.g. { profileVisibility: "PUBLIC", showActivity: true }

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Community {
  id             String           @id @default(uuid())
  name           String
  description    String
  rules          String[]
  coverImage     String?
  avatarUrl      String?
  sports         String[]
  tags           String[]
  location       String?
  primaryVenueId String?
  privacy        CommunityPrivacy @default(PUBLIC)
  status         CommunityStatus  @default(PENDING)
  ownerId        String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  owner        User              @relation("CommunityOwner", fields: [ownerId], references: [id])
  primaryVenue Venue?            @relation("CommunityPrimaryVenue", fields: [primaryVenueId], references: [id], onDelete: SetNull)
  members      CommunityMember[]
  posts        Post[]
  matches      Match[]

  @@index([status])
  @@index([ownerId])
  @@index([primaryVenueId])
}

model CommunityMember {
  id          String                @id @default(uuid())
  userId      String
  communityId String
  role        CommunityRole         @default(MEMBER)
  status      CommunityMemberStatus @default(APPROVED)
  joinedAt    DateTime              @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([userId, communityId])
}

model Venue {
  id                String       @id @default(uuid())
  name              String
  location          String
  formattedAddress  String?
  city              String?
  latitude          Float?
  longitude         Float?
  googleMapsUrl     String?
  mapboxCoordinates Json?
  pricing           String?
  amenities         String[]
  sports            String[]
  photos            String[]
  description       String?      @db.Text
  operatingHours    Json?
  contactEmail      String?
  contactPhone      String?
  website           String?
  status            VenueStatus @default(PENDING)
  ownerId           String
  aiSummary         String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  owner   User           @relation("VenueOwner", fields: [ownerId], references: [id])
  reviews VenueReview[]
  matches Match[]
  primaryForCommunities Community[] @relation("CommunityPrimaryVenue")

  @@index([status])
  @@index([latitude, longitude]) // Spatial queries approximation
}

model Match {
  id            String          @id @default(uuid())
  title         String
  sport         String
  date          DateTime
  location      String
  latitude      Float?
  longitude     Float?
  maxPlayers    Int
  costPerPerson Float?
  skillLevel    MatchSkillLevel @default(ALL)
  matchType     MatchType       @default(CASUAL)
  status        MatchStatus     @default(OPEN)
  creatorId     String
  communityId   String?
  venueId       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  creator   User           @relation("MatchCreator", fields: [creatorId], references: [id])
  community Community?     @relation(fields: [communityId], references: [id], onDelete: SetNull)
  venue     Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  players   MatchPlayer[]
  comments  MatchComment[]
  reviews   MatchReview[]

  @@index([date, sport])
  @@index([status])
  @@index([status, date])
  @@index([latitude, longitude])
  @@index([creatorId])
  @@index([venueId])
}

model MatchComment {
  id        String   @id @default(uuid())
  matchId   String
  userId    String
  content   String
  parentId  String? // For nested replies
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  match   Match          @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  MatchComment?  @relation("MatchCommentToComment", fields: [parentId], references: [id])
  replies MatchComment[] @relation("MatchCommentToComment")

  @@index([matchId])
}

model MatchPlayer {
  id                String            @id @default(uuid())
  matchId           String
  userId            String
  status            MatchPlayerStatus @default(PENDING)
  performanceRating Int? // 1-5 rating given by organizer post-match
  joinedAt          DateTime          @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
  @@index([userId])
}

model Tournament {
  id          String   @id @default(uuid())
  name        String
  sport       String
  startDate   DateTime
  endDate     DateTime
  location    String
  latitude    Float?
  longitude   Float?
  entryFee    Float?
  prizePool   String?
  organizerId String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organizer    User                    @relation("TournamentOrganizer", fields: [organizerId], references: [id])
  participants TournamentParticipant[]

  @@index([startDate, sport])
}

model TournamentParticipant {
  id           String                      @id @default(uuid())
  tournamentId String
  userId       String
  teamName     String?
  status       TournamentParticipantStatus @default(PENDING)
  joinedAt     DateTime                    @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model Post {
  id          String   @id @default(uuid())
  content     String
  type        PostType @default(GENERAL)
  location    String? // Optional for local feed filtering
  latitude    Float?
  longitude   Float?
  authorId    String
  communityId String?
  tags        String[]
  isEdited    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author    User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  community Community?  @relation(fields: [communityId], references: [id], onDelete: SetNull)
  replies   Reply[]
  likes     PostLike[]
  savedBy   SavedPost[]

  @@index([createdAt])
  @@index([createdAt, type])
  @@index([type])
  @@index([communityId])
  @@index([authorId])
}

model Reply {
  id        String   @id @default(uuid())
  content   String
  postId    String
  authorId  String
  parentId  String? // For nested replies
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent  Reply?      @relation("ReplyToReply", fields: [parentId], references: [id])
  replies Reply[]     @relation("ReplyToReply")
  likes   ReplyLike[]

  @@index([postId])
  @@index([authorId])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  receiverId String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  content   String
  link      String? // URL to redirect on click
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Report {
  id          String       @id @default(uuid())
  submitterId String
  targetType  ReportType
  targetId    String // UUID of the reported entity
  reason      String
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  submitter User @relation("ReportSubmitter", fields: [submitterId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
}

model Badge {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. VERIFIED_PLAYER, TOURNAMENT_WINNER
  description String
  icon        String?

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model PostLike {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model ReplyLike {
  id        String   @id @default(uuid())
  userId    String
  replyId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reply Reply @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@unique([userId, replyId])
}

model SavedPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
}

model VenueReview {
  id        String   @id @default(uuid())
  venueId   String
  userId    String
  rating    Int // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  venue Venue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([venueId, userId]) // one review per user per venue
}

model Activity {
  id         String       @id @default(uuid())
  userId     String
  type       ActivityType
  entityId   String? // ID of the related entity
  entityType String? // Type of entity (Match, Community, etc.)
  metadata   Json? // Flexible metadata
  createdAt  DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

model UserReview {
  id          String   @id @default(uuid())
  reviewerId  String
  targetId    String
  rating      Int      // 1 to 5
  comment     String?
  createdAt   DateTime @default(now())

  reviewer User @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  target   User @relation("ReviewedUser", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([reviewerId, targetId])
  @@index([targetId])
}

model MatchReview {
  id        String   @id @default(uuid())
  matchId   String
  userId    String
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([matchId, userId])
}

model UserConnection {
  id         String   @id @default(uuid())
  requesterId String
  recipientId String
  status     ConnectionStatus @default(PENDING) // PENDING, ACCEPTED, BLOCKED
  createdAt  DateTime @default(now())
  
  requester User @relation("ConnectionsInitiated", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient User @relation("ConnectionsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  
  @@unique([requesterId, recipientId])
}
